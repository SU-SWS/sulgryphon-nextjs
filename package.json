{
  "name": "basic-starter",
  "version": "1.4.1",
  "private": true,
  "license": "MIT",
  "scripts": {
    "dev": "NODE_OPTIONS='--inspect' next dev --webpack",
    "build": "next build --webpack",
    "preview": "next build --webpack && next start",
    "start": "next start",
    "export": "next build --webpack && next export --webpack",
    "lint": "eslint ./src ./app && tsc",
    "validate:html": "node scripts/validate-html.mjs",
    "validate:a11y": "node scripts/validate-a11y.mjs",
    "graphql": "DOTENV_CONFIG_PATH=./.env.local graphql-codegen --config codegen.ts -r dotenv/config",
    "postinstall": "git config --local core.hooksPath .githooks/; exit 0"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@formkit/auto-animate": "^0.10.2",
    "@heroicons/react": "^2.2.0",
    "@next/third-parties": "16.4.6",
    "@tailwindcss/postcss": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "algoliasearch": "^5.64.0",
    "clsx": "^2.1.1",
    "decanter": "8.0.0-beta.2",
    "html-entities": "^2.6.0",
    "html-react-parser": "^6.1.9",
    "instantsearch.js": "^4.123.0",
    "jsona": "^1.14.0",
    "next": "^16.4.6",
    "postcss": "^8.5.33",
    "react": "19.3.1",
    "react-countup": "^6.5.3",
    "react-dom": "19.3.1",
    "react-error-boundary": "^6.1.6",
    "react-focus-lock": "^2.13.7",
    "react-instantsearch": "^7.55.0",
    "react-obfuscate": "^3.7.0",
    "react-obfuscate-email": "^2.0.5",
    "react-super-responsive-table": "^6.0.2",
    "react-tiny-oembed": "^1.1.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^6.0.3",
    "usehooks-ts": "^3.1.1"
  },
  "devDependencies": {
    "@axe-core/webdriverjs": "4.14.0",
    "@graphql-codegen/add": "^6.0.1",
    "@graphql-codegen/cli": "6.3.1",
    "@graphql-codegen/client-preset": "^5.3.0",
    "dotenv": "^18.0.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-prettier": "^5.5.7",
    "graphql": "^16.15.0",
    "html-validate": "11.21.1",
    "prettier": "^3.10.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "selenium-webdriver": "4.52.0"
