# Copy this file to .env.local and fill in the values. Secrets can be found in the Vercel project's
# Environment Variables (or pulled with `vercel env pull .env.local`).
#
# NEXT_PUBLIC_* values are inlined into the client bundle at build time: changing them requires a rebuild, and
# they must never hold secrets.

# ---------------------------------------------------------------------------------------------------------------------
# Drupal (required)
# ---------------------------------------------------------------------------------------------------------------------

# Base URL of the Drupal CMS, without a trailing slash. GraphQL is queried at `<url>/graphql`, and Drupal images,
# files and the /saml/login redirect point here.
NEXT_PUBLIC_DRUPAL_BASE_URL=https://library-dev.sites-pro.stanford.edu

# Text shown next to the Stanford wordmark in the site lockup. Useful to tell environments apart locally.
NEXT_PUBLIC_SITE_NAME=Local Environment

# Basic auth credentials (`user:pass`) sent with every GraphQL request to Drupal for published content.
#DRUPAL_BASIC_AUTH=foo:bar

# Basic auth credentials (`user:pass`) for an account that can see unpublished content. Used for editor previews
# (falls back to DRUPAL_BASIC_AUTH) and by `yarn graphql` to introspect the schema for codegen.
#DRUPAL_BASIC_AUTH_ADMIN=bar:foo

# Shared secret Drupal includes in preview links (`/preview?secret=…&slug=/path`). Must match the value configured
# in Drupal. Requests with a missing or wrong secret get a 404.
#DRUPAL_PREVIEW_SECRET=DRUPAL_PREVIEW_SECRET

# Shared secret Drupal uses to call `/api/revalidate` (as `?secret=` or an `Authorization: Bearer` header) when
# content is saved. Must match the value configured in Drupal.
#DRUPAL_REVALIDATE_SECRET=DRUPAL_REVALIDATE_SECRET

# Optional. Extra headers added to every request to Drupal, as a JSON object (e.g. a WAF bypass header). Invalid
# JSON is ignored with a warning.
#DRUPAL_REQUEST_HEADER={"X-Example-Header":"value"}

# ---------------------------------------------------------------------------------------------------------------------
# LibGuides / LibApps (optional)
# ---------------------------------------------------------------------------------------------------------------------

# OAuth client credentials for the LibApps API, used to show LibGuides staff and subject guides. Without them, LibGuides
# data is skipped and a warning is logged.
#LIBGUIDE_CLIENT_ID=LIBGUIDE_CLIENT_ID
#LIBGUIDE_CLIENT_SECRET=LIBGUIDE_CLIENT_SECRET

# ---------------------------------------------------------------------------------------------------------------------
# Algolia site search (optional)
# ---------------------------------------------------------------------------------------------------------------------

# When all three are set they take precedence over the Algolia fields in the Drupal "Site Settings". Without any
# Algolia configuration, /search falls back to the Drupal search view. ALGOLIA_KEY must be the SEARCH-ONLY key,
# never the admin key.
#ALGOLIA_ID=ALGOLIA_ID
#ALGOLIA_INDEX=ALGOLIA_INDEX
#ALGOLIA_KEY=ALGOLIA_KEY

# ---------------------------------------------------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------------------------------------------------

# Google Analytics measurement ID (e.g. G-XXXXXXXXXX). Leave unset locally so development traffic isn't tracked.
#NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# ---------------------------------------------------------------------------------------------------------------------
# Build
# ---------------------------------------------------------------------------------------------------------------------

# 'true' prerenders every Drupal node during `yarn build` (production). Keep 'false' locally: only /home is
# prerendered and other pages render on first request, then are cached.
BUILD_COMPLETE=false

# VERCEL_ENV and CI are set by Vercel and CI automatically; don't set them here. On non-production environments
# (VERCEL_ENV !== 'production') pages are served with `X-Robots-Tag: noindex` and show a "flush cache" button.
